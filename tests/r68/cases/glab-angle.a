* expect text: 12345678 3e3e3e3e 3e3e3e3e 3e3e3e3e 3e3e3e3e 696e746f 3c3c3c3c 3c3c3c3c 3c3c3c3c 3c3c3c3c 4e714e71
* expect sym: T Text 00000004
 psect glab_angle,0,0,0,0,0
		dc.l $12345678
Text:	dc.b ">>>>>>>>>>>>>>>>"
		dc.b "into"
		dc.b "<<<<<<<<<<<<<<<<"
 nop
