* The same as macro-equ-imm with -dialect=c32 (checked with C 3.2's R68: identical code).
* fixed: e33fcc8 2026-10-16 r68togas: moveq and move.b immediates of names defined in macro expansions
* options: -dialect=c32
* expect text: 7680 7081 74c8 177c00fe0001 123c0080 7800 4e71
 psect c32_macro_equ_imm,0,0,0,0,0
Bit macro
m\1 equ 1<<.
b\1 do.b 1
 endm
Num macro
q\1 equ \2
 endm
 org 7
 Bit Hi
 org 0
 Bit Lo
 Num Big,200
 moveq #mHi,d3
 moveq #(mHi+mLo),d0
 moveq #qBig,d2
 move.b #^mLo,1(a3)
 move.b #mHi,d1
 moveq #Ext,d4
 nop
 ends
