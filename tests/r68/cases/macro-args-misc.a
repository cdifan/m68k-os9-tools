* Macro arguments and names: \' outside a macro body (TR.l #\'Abcd\'); quotes inside an argument
* (TR.l #"'"Wxyz"'": #'Wxyz'); = in an argument (a keyword argument to gas's macros); a macro
* named as a gas directive (ERROR: gas's error came first); a global label made by a macro (\1:)
* no longer makes every name a label of the source (Buf+R$pc became a link-time expression
* again); move ccr,d2 (the 68010's); movep (a1),d0 (0(a1) to gas).
* fixed: ff2b5af 2026-10-11 r68togas: macro arguments and names; move ccr; movep (An)
* expect text: 2afc4162 63642afc 5778797a 323c4502 3d002d40 000042c2 01090000
* expect reloc: r68x_
TL	macro
\1:	nop
	endm
TR.l	macro
	move.l	\1,(a5)+
	endm
ERROR	MACRO
	move.w	#('\2'*256)+\1,d1
	ENDM
EQ	macro
	dc.b	'\1'
	endm
 psect macro_args_misc,0,0,0,0,0
	TR.l	#\'Abcd\'
	TR.l	#"'"Wxyz"'"
	ERROR	2,E
	EQ	=
	move.l	d0,Buf+R$pc(a6)
	move	ccr,d2
	movep.w	(a1),d0
 ends
